# Node backend (Express)
# Copy to .env and set real keys/secrets.

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

GOOGLE_API_KEY=your_google_api_key

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
MAX_IMAGE_PROMPTS=4

EMBEDDING_FALLBACK=zeros
EMBEDDING_FALLBACK_DIM=768

COLLABORA_URL=http://localhost:9980
WOPI_BASE_URL=http://localhost:5000
WOPI_SECRET=change_me

CONSISTENT_SLIDES_URL=

SLIDESPEAK_API_KEY=
SLIDESPEAK_BASE_URL=https://api.slidespeak.co

QDRANT_URL=http://localhost:6333

