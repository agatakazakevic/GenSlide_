# Advanced Deck Creator (FastAPI)
# Copy to .env and set real keys/secrets.

PORT=8002
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Providers
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Model routing
MODEL_PREFERENCE=gemini
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=models/gemini-2.5-flash
GEMINI_IMAGE_MODEL=models/gemini-2.5-flash-image
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Uploads / assets
UPLOAD_DIR=./uploads
IMAGE_OUTPUT_DIR=./uploads/images
RAG_UPLOAD_DIR=../backend/uploads
MAX_FILE_SIZE=52428800

# Generation controls
LLM_CONCURRENCY=4
ENABLE_IMAGE_GENERATION=0
CHART_MIN_DENSITY=0.4
CHART_LABEL_MAX_LEN=24
CHART_LABEL_MAX_WORDS=4
CHART_LABEL_TRUNCATE=1
CHART_SERIES_NAME_MAX_LEN=40

# HTML / renderer
HTML_DISABLE_CHARTS=0
HTML_SKIP_CHARTS=0
HTML_AGENTIC_MAX_CONCURRENCY=3
HTML_AGENTIC_SLIDE_RETRIES=3
HTML_AGENTIC_TEMPERATURE=0.7
HTML_AGENTIC_TEMPERATURE_RETRY=0.4

# Visual QA
ENABLE_HTML_VISUAL_QA=1
HTML_VISUAL_QA_MAX_ITERS=2
VISUAL_QA_FREE_TEXT=1
VISUAL_QA_FREE_TEXT_MAX_CHARS=1200
VISUAL_QA_OUTPUT_DIR=/tmp/slide_reviews
VISUAL_QA_DEBUG_FULLPAGE=0

# RAG hybrid
DATABASE_URL=postgresql://user:pass@host:5432/postgres
ENABLE_LOCAL_EMBED_RAG=0
LOCAL_EMBED_CANDIDATES=40
RAG_HYBRID_VECTOR_WEIGHT=0.7
RAG_HYBRID_KEYWORD_WEIGHT=0.3

# Validation and tracing
SLIDE_SCHEMA_STRICT=false
HARD_CONSTRAINTS=1
AGENT_TRACE_DIR=/tmp

